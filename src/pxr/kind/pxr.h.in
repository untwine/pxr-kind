#ifndef PXR_KIND_H
#define PXR_KIND_H

#include <pxr/tf/pxr.h>
#include <pxr/plug/pxr.h>

#ifdef PXR_PYTHON_SUPPORT_ENABLED
#include <pxr/boost/python/common.hpp>
#endif

#define KIND_MAJOR_VERSION @PROJECT_VERSION_MAJOR@
#define KIND_MINOR_VERSION @PROJECT_VERSION_MINOR@
#define KIND_PATCH_VERSION @PROJECT_VERSION_PATCH@

#define KIND_VERSION (KIND_MAJOR_VERSION * 10000 \
                    + KIND_MINOR_VERSION * 100   \
                    + KIND_PATCH_VERSION)

#define PXR_NS pxr
#define KIND_INTERNAL_NS pxrInternal_v@PROJECT_VERSION_MAJOR@_@PROJECT_VERSION_MINOR@_@PROJECT_VERSION_PATCH@__pxrReserved__
#define PXR_NS_GLOBAL ::PXR_NS

namespace KIND_INTERNAL_NS { }

namespace PXR_NS {
    using namespace KIND_INTERNAL_NS;
}

// Import direct dependencies into kind's internal namespace.
// This keeps resolution correct if package versions ever drift.
namespace KIND_INTERNAL_NS {
    using namespace TF_INTERNAL_NS;
    using namespace PLUG_INTERNAL_NS;
#ifdef PXR_PYTHON_SUPPORT_ENABLED
    using namespace BOOST_INTERNAL_NS;
#endif
}

#define KIND_NAMESPACE_OPEN_SCOPE   namespace KIND_INTERNAL_NS {
#define KIND_NAMESPACE_CLOSE_SCOPE  }
#define KIND_NAMESPACE_USING_DIRECTIVE using namespace PXR_NS;

#endif // PXR_KIND_H
