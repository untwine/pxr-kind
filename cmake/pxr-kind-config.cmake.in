include(CMakeFindDependencyMacro)

@PACKAGE_INIT@

find_dependency(pxr-tf 0.26.8 EXACT REQUIRED)
find_dependency(pxr-plug 0.26.8 EXACT REQUIRED)

set(_with_py_bindings "@BUILD_PYTHON_BINDINGS@")
if(_with_py_bindings)
    find_dependency(pxr-boost 0.26.8 EXACT REQUIRED)
endif()

include(${CMAKE_CURRENT_LIST_DIR}/pxr-kind-targets.cmake)
